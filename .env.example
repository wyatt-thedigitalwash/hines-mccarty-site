# Copy to .env.local for local testing, and set the same three in Vercel
# (Project Settings > Environment Variables) for the live site. D83.
#
# The contact form sends only when all three are set. Until then it tells
# visitors to call, the contact page stays noindex, and it stays out of the
# sitemap.

# Resend API key (resend.com > API Keys). Never commit a real key.
RESEND_API_KEY=

# The sender. Must be on a domain verified in Resend; thedigitalwash.com is,
# so the firm's own domain needs no DNS records. The display name is what the
# firm sees in its inbox.
CONTACT_FROM_EMAIL="Hines McCarty Pavlidis Website <website@thedigitalwash.com>"

# The inbox that receives enquiries. Replies go to the visitor's own address.
CONTACT_TO_EMAIL=
