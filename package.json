{
  "name": "hines-mccarty-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:c9": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-c9.mts",
    "prebuild": "npm run check:c9 && npm run check:pages && npm run check:unverified && npm run check:claims && npm run check:provenance && npm run check:routes",
    "check:pages": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-pages.mts",
    "check:unverified": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-unverified.mts",
    "prewrite": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-unverified.mts",
    "check:claims": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-claims.mts",
    "check:rendered": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-rendered.mts",
    "postbuild": "npm run check:rendered && npm run check:routes:rendered",
    "check:provenance": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-provenance.mts",
    "check:routes": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-routes.mts",
    "check:routes:rendered": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-routes.mts --rendered"
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "d3-geo": "^3.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "topojson-client": "^3.1.0",
    "typescript": "^5",
    "us-atlas": "^3.0.1"
  }
}
